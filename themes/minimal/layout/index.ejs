<ul class="post-list">
  <% page.posts.each(function(post){ %>
    <li>
      <span class="date"><%= date(post.date, "YYYY-MM-DD") %></span>
      <% if (post.categories && post.categories.length > 0) { %>
        <span class="category-tag"><%= post.categories.data[0].name %></span>
      <% } %>
      <a href="<%- url_for(post.path) %>"><%= post.title %></a>
    </li>
  <% }) %>
</ul>

<% if (page.total > 1){ %>
  <nav class="pagination">
    <%- paginator({
      prev_text: '&laquo; Prev',
      next_text: 'Next &raquo;'
    }) %>
  </nav>
<% } %>

<section class="projects" aria-labelledby="projects-heading">
  <h2 id="projects-heading">项目</h2>
  <a class="project-link" href="https://sza0415.github.io/eval/">
    <img class="project-preview" src="<%- url_for('images/eval-preview.jpg') %>" alt="OmniJev 视觉决策评测首页预览" width="1220" height="1050" loading="lazy" decoding="async">
    <span class="project-info">
      <span class="project-title">OmniJev 视觉决策评测 <span aria-hidden="true">↗</span></span>
      <span class="project-description">机器人、游戏、网页与棋盘场景中的视觉决策评测，与 Qwen3.5 对照。</span>
    </span>
  </a>
</section>
