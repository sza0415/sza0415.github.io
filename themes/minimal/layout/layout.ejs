<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8">
  <title><%= page.title ? page.title + " | " : "" %><%= config.title %></title>
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <link rel="stylesheet" href="<%- config.root %>css/style.css?v=20261010-github-link">
</head>
<body>
  <div class="container">
    <header>
      <h1><a href="<%- config.root %>"><%= config.title %></a></h1>
      <p class="subtitle"><%= config.subtitle %></p>
      <% if (config.description) { %>
        <p class="description"><a href="mailto:<%= String(config.description).trim() %>"><%= String(config.description).trim() %></a></p>
      <% } %>
      <nav class="site-nav">
        <a href="<%- config.root %>">首页</a>
        <a href="<%- config.root %>essays/">随笔</a>
        <a href="<%- config.root %>thoughts/">随想</a>
        <a href="<%- config.root %>excerpts/">摘录</a>
        <a href="<%- url_for('notes/') %>">学习笔记</a>
        <a class="github-link" href="https://github.com/sza0415" target="_blank" rel="noopener noreferrer" aria-label="访问 sza0415 的 GitHub 主页（在新标签页打开）" title="GitHub 主页">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false">
            <path d="M12 .297C5.37.297 0 5.67 0 12.297c0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.043-1.61-4.043-1.61-.546-1.387-1.333-1.756-1.333-1.756-1.09-.745.083-.729.083-.729 1.205.084 1.838 1.237 1.838 1.237 1.07 1.835 2.807 1.305 3.492.998.108-.776.418-1.305.762-1.605-2.665-.3-5.467-1.334-5.467-5.93 0-1.31.467-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23a11.5 11.5 0 0 1 3-.404c1.02.005 2.045.138 3 .404 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"/>
          </svg>
        </a>
      </nav>
    </header>
    <main>
      <%- body %>
    </main>
    <footer>
      <p>&copy; <%= new Date().getFullYear() %> <%= config.author %></p>
    </footer>
  </div>
</body>
</html>
